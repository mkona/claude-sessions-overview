{
  "name": "claude-sessions-overview",
  "displayName": "Claude Sessions",
  "description": "Every Claude Code session on this machine in one window: a sidebar of sessions across all projects, a chat tab per session, and the files each session changed.",
  "version": "0.5.0",
  "publisher": "milo",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:claudeSessions.chat"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeSessions",
          "title": "Claude Sessions",
          "icon": "media/claude.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "claudeSessionsChanges",
          "title": "Session Changes",
          "icon": "media/claude.svg"
        }
      ]
    },
    "views": {
      "claudeSessions": [
        {
          "type": "webview",
          "id": "claudeSessions.panel",
          "name": "Sessions",
          "icon": "media/claude.svg"
        }
      ],
      "claudeSessionsChanges": [
        {
          "id": "claudeSessions.changes",
          "name": "Changes",
          "icon": "media/claude.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeSessions.newSession",
        "title": "New Session",
        "category": "Claude Sessions",
        "icon": "$(add)"
      },
      {
        "command": "claudeSessions.openInProjectWindow",
        "title": "Open in Project Window",
        "category": "Claude Sessions",
        "icon": "$(multiple-windows)"
      },
      {
        "command": "claudeSessions.changes.openAll",
        "title": "Open All Session Changes",
        "category": "Claude Sessions",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "claudeSessions.changes.refresh",
        "title": "Refresh Session Changes",
        "category": "Claude Sessions",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeSessions.changes.switchBranch",
        "title": "Switch Branch",
        "category": "Claude Sessions",
        "icon": "$(git-branch)"
      },
      {
        "command": "claudeSessions.changes.openScm",
        "title": "Show Source Control",
        "category": "Claude Sessions",
        "icon": "$(source-control)"
      },
      {
        "command": "claudeSessions.changes.openFile",
        "title": "Open File",
        "category": "Claude Sessions"
      },
      {
        "command": "claudeSessions.changes.openDiff",
        "title": "Open Session Changes",
        "category": "Claude Sessions"
      },
      {
        "command": "claudeSessions.refresh",
        "title": "Refresh",
        "category": "Claude Sessions",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeSessions.toggleEnded",
        "title": "Show/Hide Ended Sessions",
        "category": "Claude Sessions",
        "icon": "$(history)"
      },
      {
        "command": "claudeSessions.toggleGrouping",
        "title": "Group by Project / Flat List",
        "category": "Claude Sessions",
        "icon": "$(list-tree)"
      },
      {
        "command": "claudeSessions.open",
        "title": "Go to Session",
        "category": "Claude Sessions"
      },
      {
        "command": "claudeSessions.openFolderWindow",
        "title": "Focus Project Window",
        "category": "Claude Sessions",
        "icon": "$(window)"
      },
      {
        "command": "claudeSessions.resumeInTerminal",
        "title": "Resume in Terminal Here",
        "category": "Claude Sessions",
        "icon": "$(terminal)"
      },
      {
        "command": "claudeSessions.copyId",
        "title": "Copy Session ID",
        "category": "Claude Sessions"
      },
      {
        "command": "claudeSessions.openTranscript",
        "title": "Open Transcript File",
        "category": "Claude Sessions"
      },
      {
        "command": "claudeSessions.focusView",
        "title": "Show Sessions",
        "category": "Claude Sessions"
      },
      {
        "command": "claudeSessions.refreshUsage",
        "title": "Refresh Usage",
        "category": "Claude Sessions",
        "icon": "$(dashboard)"
      },
      {
        "command": "claudeSessions.collapseAll",
        "title": "Collapse All Projects",
        "category": "Claude Sessions",
        "icon": "$(collapse-all)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeSessions.newSession",
          "when": "view == claudeSessions.panel",
          "group": "navigation@0"
        },
        {
          "command": "claudeSessions.refresh",
          "when": "view == claudeSessions.panel",
          "group": "navigation@1"
        },
        {
          "command": "claudeSessions.toggleEnded",
          "when": "view == claudeSessions.panel",
          "group": "navigation@2"
        },
        {
          "command": "claudeSessions.toggleGrouping",
          "when": "view == claudeSessions.panel",
          "group": "navigation@3"
        },
        {
          "command": "claudeSessions.collapseAll",
          "when": "view == claudeSessions.panel",
          "group": "navigation@4"
        },
        {
          "command": "claudeSessions.changes.openAll",
          "when": "view == claudeSessions.changes && claudeSessions.changes.hasSession",
          "group": "navigation@1"
        },
        {
          "command": "claudeSessions.changes.switchBranch",
          "when": "view == claudeSessions.changes && claudeSessions.changes.hasSession",
          "group": "navigation@2"
        },
        {
          "command": "claudeSessions.changes.openScm",
          "when": "view == claudeSessions.changes",
          "group": "navigation@3"
        },
        {
          "command": "claudeSessions.changes.refresh",
          "when": "view == claudeSessions.changes",
          "group": "navigation@4"
        }
      ],
      "commandPalette": [
        {
          "command": "claudeSessions.open",
          "when": "false"
        },
        {
          "command": "claudeSessions.openFolderWindow",
          "when": "false"
        },
        {
          "command": "claudeSessions.resumeInTerminal",
          "when": "false"
        },
        {
          "command": "claudeSessions.copyId",
          "when": "false"
        },
        {
          "command": "claudeSessions.openTranscript",
          "when": "false"
        },
        {
          "command": "claudeSessions.openInProjectWindow",
          "when": "false"
        },
        {
          "command": "claudeSessions.changes.openFile",
          "when": "false"
        },
        {
          "command": "claudeSessions.changes.openDiff",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "claudeSessions.open",
          "when": "webviewId == claudeSessions.panel && webviewSection == session",
          "group": "1_actions@0"
        },
        {
          "command": "claudeSessions.resumeInTerminal",
          "when": "webviewId == claudeSessions.panel && webviewSection == session",
          "group": "1_actions@1"
        },
        {
          "command": "claudeSessions.openTranscript",
          "when": "webviewId == claudeSessions.panel && webviewSection == session",
          "group": "2_info@1"
        },
        {
          "command": "claudeSessions.copyId",
          "when": "webviewId == claudeSessions.panel && webviewSection == session",
          "group": "2_info@2"
        },
        {
          "command": "claudeSessions.openInProjectWindow",
          "when": "webviewId == claudeSessions.panel && webviewSection == session",
          "group": "1_actions@2"
        },
        {
          "command": "claudeSessions.openFolderWindow",
          "when": "webviewId == claudeSessions.panel && (webviewSection == session || webviewSection == project)",
          "group": "1_actions@3"
        }
      ],
      "view/item/context": [
        {
          "command": "claudeSessions.changes.openFile",
          "when": "view == claudeSessions.changes && viewItem == claudeSessionsChange",
          "group": "navigation@1"
        },
        {
          "command": "claudeSessions.changes.openDiff",
          "when": "view == claudeSessions.changes && viewItem == claudeSessionsChange",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Claude Sessions",
      "properties": {
        "claudeSessions.claudeDir": {
          "type": "string",
          "default": "",
          "description": "Claude config directory. Empty = $CLAUDE_CONFIG_DIR or ~/.claude."
        },
        "claudeSessions.refreshIntervalSeconds": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "description": "How often to re-read session state."
        },
        "claudeSessions.showEnded": {
          "type": "boolean",
          "default": true,
          "description": "Show sessions that are no longer running."
        },
        "claudeSessions.endedMaxAgeDays": {
          "type": "number",
          "default": 14,
          "description": "Hide ended sessions older than this many days."
        },
        "claudeSessions.maxEndedPerProject": {
          "type": "number",
          "default": 8,
          "description": "Max ended sessions listed per project."
        },
        "claudeSessions.groupByProject": {
          "type": "boolean",
          "default": true,
          "description": "Group sessions under their project folder."
        },
        "claudeSessions.notifyNeedsAnswer": {
          "type": "boolean",
          "default": true,
          "description": "Pop a notification when a session starts waiting for your answer."
        },
        "claudeSessions.resumeEndedCliSessions": {
          "type": "boolean",
          "default": true,
          "description": "Clicking an ended CLI session opens a terminal running `claude --resume <id>` in its project window."
        },
        "claudeSessions.claudeCommand": {
          "type": "string",
          "default": "claude",
          "description": "Command used to resume sessions in a terminal."
        },
        "claudeSessions.showUsage": {
          "type": "boolean",
          "default": true,
          "description": "Show the Usage block (5h / 7d / model limits) at the top of the view."
        },
        "claudeSessions.usageRefreshMinutes": {
          "type": "number",
          "default": 2,
          "minimum": 0.5,
          "description": "How often to fetch usage from Anthropic."
        },
        "claudeSessions.openIn": {
          "type": "string",
          "enum": [
            "thisWindow",
            "projectWindow"
          ],
          "enumDescriptions": [
            "Open the session as a chat tab in this window.",
            "Focus the VS Code window that has the project open (the pre-0.5 behavior)."
          ],
          "default": "thisWindow",
          "description": "What clicking a session does."
        },
        "claudeSessions.addProjectToWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "Add a session's project folder to this window as a workspace folder, so search, SCM and other extensions see it."
        },
        "claudeSessions.defaultPermissionMode": {
          "type": "string",
          "enum": [
            "default",
            "acceptEdits",
            "plan",
            "auto",
            "bypassPermissions"
          ],
          "enumDescriptions": [
            "Ask before edits and commands.",
            "Accept file edits automatically.",
            "Plan first, do not change anything.",
            "Let Claude decide when to ask.",
            "Skip all permission prompts."
          ],
          "default": "default",
          "description": "Permission mode new chats start in."
        },
        "claudeSessions.defaultModel": {
          "type": "string",
          "default": "",
          "description": "Model new chats start with. Empty = the Claude CLI default (for example 'sonnet' or a full model id)."
        },
        "claudeSessions.idleShutdownMinutes": {
          "type": "number",
          "default": 20,
          "minimum": 0,
          "description": "Stop a chat\u2019s Claude process after this many idle minutes. 0 keeps it running until the tab closes."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.webview.json",
    "package": "npm run typecheck && npm run build && vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.100.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.332",
    "@anthropic-ai/sdk": "^1.14.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "marked": "^18.3.0",
    "zod": "^4.6.7"
  }
}
